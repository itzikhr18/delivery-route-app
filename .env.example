# Copy this file to .env for local API testing.

PORT=8787
HOST=127.0.0.1

# Recommended for a paid beta.
# Create a key in Geoapify and keep it only on the backend.
GEOAPIFY_API_KEY=
GEOCODING_PROVIDER=geoapify
ROUTING_PROVIDER=geoapify

# Keep this tight in production, for example:
# ALLOWED_ORIGINS=https://itzikhr18.github.io
ALLOWED_ORIGINS=*

RATE_LIMIT_PER_MINUTE=60
ROUTE_STOP_LIMIT=60
CACHE_TTL_DAYS=90
REQUEST_TIMEOUT_MS=30000

# Only used when GEOAPIFY_API_KEY is empty and the backend falls back to public APIs.
PUBLIC_API_DELAY_MS=1100
NOMINATIM_USER_AGENT=DeliveryRouteAppBackend/3.7.0
